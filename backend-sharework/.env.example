PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/sharework
# Spec alias: MONGO_URI

JWT_SECRET=replace_with_long_random_jwt_secret
JWT_EXPIRES_IN=7d
# Spec alias: JWT_EXPIRE
JWT_REFRESH_SECRET=replace_with_long_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
# Spec alias: JWT_REFRESH_EXPIRE

CLIENT_URL=http://localhost:3000
# Customer/Provider UI :3000, Admin UI :3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

PLATFORM_FEE_PERCENT=10
GST_ON_FEE_PERCENT=18

AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_BUCKET=sharework-uploads
AWS_REGION=ap-south-1

RESEND_API_KEY=replace_me
# Verified Resend sender, e.g. ShareWork <noreply@your-domain.com>
# Aliases: MAIL_FROM, EMAIL_FROM
RESEND_FROM=ShareWork <noreply@example.com>

OTP_EXPIRY_MIN=10
BCRYPT_SALT_ROUNDS=12

# Non-production only. Rejected when NODE_ENV=production.
# Leave empty to generate a random OTP. Spec MVP path uses 123456 when set.
# Spec alias: MVP_OTP
DEV_OTP=
